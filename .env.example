# Local development template: copy to .env in the repository root. Web, API and worker load it.
# For Easypanel production, use docs/deploy-easypanel.md; do not upload these local defaults unchanged.
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://127.0.0.1:3000
# Optional exact app hostnames, comma-separated. No URLs, paths or wildcards.
# WEB_ORIGIN remains the canonical origin for authentication and callbacks.
APP_HOSTNAMES=
WORKER_HEALTH_PORT=4001
# api keeps current polling; worker moves 11 handlers (messaging stays API-owned); disabled stops all.
BACKGROUND_EXECUTOR=api
# disabled and dry-run never execute worker jobs; enabled requires BACKGROUND_EXECUTOR=worker.
WORKER_MODE=disabled
# Reserved for legacy infrastructure; current durable handlers use the configured database, not Redis.
REDIS_URL=
# Supabase identity requires both URL and public anon/publishable key. Never use a service key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
API_INTERNAL_URL=http://127.0.0.1:4000
# Reserved for later integrations; not used by identity.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
ASAAS_API_KEY=
# Reserved for application email delivery. Auth emails use SMTP configured in Supabase.
RESEND_API_KEY=

# Current alternative to SUPABASE_ANON_KEY; set one public key, never a secret key.
SUPABASE_PUBLISHABLE_KEY=
# URLs and later integrations require their own setup and validation.
APP_BASE_URL=
PUBLIC_SITE_URL=
CUSTOMER_SITES_BASE_DOMAIN=
DATABASE_URL=
# Used by the persisted company journey. Requires API billing and model access.
# IDs devem ser confirmados na conta; não há modelo implícito.
OPENAI_MODEL_ANALYSIS=
OPENAI_MODEL_STRATEGY=
OPENAI_MODEL_COPY=
OPENAI_MODEL_CHAT=
# Optional: visual descriptions of uploaded materials. Image generation uses OpenAI.
GEMINI_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_PLACES_SERVER_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=
ASAAS_WEBHOOK_AUTH_TOKEN=
ASAAS_ENVIRONMENT=sandbox
EMAIL_FROM=
HOSTING_PROVIDER_TOKEN=
HOSTING_PROJECT_ID=
SECRETS_ENCRYPTION_KEY=
# Evolution transport is pending; these variables alone do not connect WhatsApp.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Instance name is computed per company: askadia-{companyId}. No shared instance.
EVOLUTION_WEBHOOK_SECRET=

# Consumer for new WhatsApp messages; activation remains explicit per company/channel.
INBOX_AUTOMATION_ENABLED=false

# Scheduled relationship campaigns. Requires migrations 006-008 and explicit activation per campaign.
MESSAGE_CAMPAIGNS_ENABLED=false

# Google Ads: OAuth web client and approved developer token; no credentials in git
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_API_VERSION=v25
# Hosted company sites: CNAME target and optional IPv4 for apex domains
SITES_CNAME_TARGET=askadia.com.br
SITES_SERVER_IP=

# Optional domain + HTTPS automation (server-only token restricted to Askadia project)
EASYPANEL_API_URL=
EASYPANEL_API_TOKEN=
EASYPANEL_SITE_PROJECT=askadia
EASYPANEL_SITE_SERVICE=askadia
EASYPANEL_CERTIFICATE_RESOLVER=

SITES_PLATFORM_DOMAIN=askadia.com.br
OPENAI_MODEL_SITE=
GEMINI_DESCRIPTION_MODEL=gemini-3.5-flash-lite
IMAGE_DESCRIPTIONS_ENABLED=true
# Automatic draft preparation after confirmed onboarding (never publishes)
CONTENT_AUTOPREP_ENABLED=true

# Public Askadia business channels (displayed on Contato/Suporte; never use private credentials)
PUBLIC_SALES_WHATSAPP=
PUBLIC_CONTACT_EMAIL=
PUBLIC_SUPPORT_EMAIL=

# Optional server-side Google Trends data provider (official embeds work without this)
SERPAPI_API_KEY=

# Preparação de campanhas e atendimento (homologar acesso ao modelo antes de ativar)
OPENAI_MODEL_ORCHESTRATOR=
OPENAI_MODEL_SEARCH=
# Ativar somente após homologar Business Discovery com a autorização Meta da empresa
INSTAGRAM_MONITOR_ENABLED=false
OPENAI_MODEL_ADS=
OPENAI_MODEL_ATTENDANCE=

# Fila persistente de edição de fotos e criativos; exige migração 202609270001.
VISUAL_JOBS_ENABLED=true

# OpenAI image generation and editing (API, billed separately).
OPENAI_MODEL_IMAGE=
OPENAI_IMAGE_QUALITY=high

# Enable after migrations; only version-approved campaigns can execute.
ADS_EXECUTION_ENABLED=false

# Simulação explícita sem cobrança; acesso de teste por empresa por 7 dias.
# disabled bloqueia novas simulações; acessos emitidos expiram ou devem ser revogados.
CHECKOUT_MODE=test

# Canal público do especialista de suporte (DDI + DDD + número, fictício)
PUBLIC_SUPPORT_WHATSAPP=5511999999999

# CNPJ público via BrasilAPI; confirmação manual sempre disponível.
CNPJ_LOOKUP_ENABLED=true
# Ativar depois da migração 202609290002 e homologação das fontes.
REGIONAL_RESEARCH_ENABLED=false

# Firebase / Firestore Native. All values below are fictitious; SQL options are legacy.
DATABASE_PROVIDER=firestore
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_STORAGE_BUCKET=your-firebase-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_API_KEY=your-public-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:example
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-EXAMPLE
# Use ADC/workload identity in production. Never commit service-account JSON.
GOOGLE_APPLICATION_CREDENTIALS=
CLOUD_SQL_CONNECTION_NAME=your-project:southamerica-east1:your-postgres-instance
CLOUD_SQL_IP_TYPE=PUBLIC
DATABASE_NAME=medsi
DATABASE_USER=medsi-api@your-project.iam
DATABASE_AUTH=iam
DATABASE_PASSWORD=
# Optional local PostgreSQL/proxy connection, server-only.
DATABASE_URL=
FIREBASE_SQL_CONNECT_SERVICE_ID=medsi
FIREBASE_SQL_CONNECT_LOCATION=southamerica-east1

# Public Firebase web API key, read at runtime by the server (Docker/Easypanel).
FIREBASE_WEB_API_KEY=your-public-web-api-key

# Firestore Native: independent from SQL Connect. No secrets here.
FIRESTORE_DATABASE_ID=(default)

# Leitura autorizada de amostra recente no X por cidade e especialidade
X_BEARER_TOKEN=

# Official WhatsApp Cloud: existing authorized app/number, server vault only.
WHATSAPP_CLOUD_CREDENTIALS_JSON=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_VERIFY_TOKEN=
# Disabled until private provider homologation and explicit operation approval.
INSTAGRAM_PUBLICATION_ENABLED=false
ASAAS_RECONCILIATION_ENABLED=false
