{
  "name": "@askadia/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @askadia/api build && tsx watch src/main.ts",
    "build": "pnpm --filter @askadia/api build && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "pnpm --filter @askadia/api build && tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.1.0",
    "dotenv": "^17.2.0",
    "@askadia/api": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.0"
  }
}
